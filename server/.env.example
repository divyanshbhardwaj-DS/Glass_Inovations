# Complete Glass Innovations — Server Environment

# ── Email (SMTP) ────────────────────────────────────────
# Credentials for the email account used to SEND enquiry notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password

# The business email address where new enquiries are forwarded
NOTIFY_TO=info@completeglassinnovations.com.au

# ── Server ──────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Admin panel ─────────────────────────────────────────
# Simple HTTP Basic auth for /admin route
ADMIN_USER=admin
ADMIN_PASS=changeme123

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins (your production domain)
ALLOWED_ORIGINS=https://completeglassinnovations.com.au,http://localhost:3000,http://localhost:3001
